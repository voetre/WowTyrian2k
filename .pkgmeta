package-as: WowTyrian2k

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Developer files stay on GitHub. Developer-only code is marked with
# --@do-not-package@ in the Lua files and is removed from the package too.
ignore:
  - docs
  - .github
  - tools
  - TODO.md
  - KNOWN_BUGS.md
